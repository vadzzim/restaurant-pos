{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // `vite.config.ts` imports its plugin with an explicit `.ts`, which Vite's native config
    // loader requires and which is only legal to write under this flag.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "vite/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  // `WebWorker` and `DOM` declare the same names with different types, so they cannot share one
  // `lib`. The worker gets `tsconfig.sw.json`; `cache-policy.ts` stays here too, because it is
  // pure and the tests import it from Node.
  "exclude": ["src/sw/service-worker.ts", "test/service-worker.test.ts"]
}
