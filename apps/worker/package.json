{
  "name": "@pos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "outbox": "tsx --env-file-if-exists=../../.env scripts/outbox-control.ts",
    "printer": "tsx --env-file-if-exists=../../.env scripts/printer-control.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@pos/config": "workspace:*",
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain": "workspace:*",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
