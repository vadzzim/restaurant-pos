{
  "name": "@pos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/config": "workspace:*",
    "@pos/contracts": "workspace:*",
    "@pos/db": "workspace:*",
    "@pos/domain": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "vitest": "^4.1.11"
  }
}
