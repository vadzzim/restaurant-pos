{
  "name": "@pos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:migrate": "node -e \"console.error('M2 not implemented'); process.exit(1)\"",
    "db:seed": "node -e \"console.error('M2 not implemented'); process.exit(1)\""
  },
  "dependencies": {
    "@pos/config": "workspace:*",
    "fastify": "^5.12.1"
  }
}
