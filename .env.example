NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:3000
WORKER_HEARTBEAT_MS=10000
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

TEST_DATABASE_URL=postgresql://pos:pos@localhost:5432/pos_test
KAFKA_CLIENT_ID=pos
KAFKA_ORDER_EVENTS_TOPIC=restaurant.order.events
KAFKA_ORDER_EVENTS_PARTITIONS=3
KITCHEN_CONSUMER_GROUP=kitchen
REALTIME_CONSUMER_GROUP=realtime
REALTIME_CONSUMER_RETRY_MS=5000
WORKER_BROKER_RETRY_MS=5000
# 1 makes both long-lived processes stop on the word `shutdown` on stdin; `verify-e2e.mjs` sets it
STDIN_SHUTDOWN=0
HEALTH_CHECK_TIMEOUT_MS=2000
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
PRINTER_URL=http://localhost:3000/api/printer/print
PRINTER_TIMEOUT_MS=3000
PRINT_ENQUEUE_TIMEOUT_MS=2000
PRINT_SHUTDOWN_TIMEOUT_MS=5000
PRINT_QUEUE_NAME=print
PRINT_MAX_ATTEMPTS=5
PRINT_BACKOFF_BASE_MS=1000
PRINT_RECONCILE_MS=15000
PRINT_RECONCILE_LIMIT=50
PRINT_STALE_MS=60000
